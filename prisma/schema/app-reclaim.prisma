// Reclaim Your Week — leaf schema (F4 t-1).
//
// The leaf's own tables, all `@@map`'d to the `app_reclaim_*` prefix. This is a NEW file:
// `app.prisma` is Sunrise's (ContactSubmission, FeatureFlag, AuthBootstrap) — never edit it (I10).
//
// **Every user reference is a plain `String` FK with NO Prisma `@relation`.** A relation needs a
// reverse field on the core `User` model, which is the fork-and-edit trap (CUSTOMIZATION.md §5). So
// the FK constraint AND its `ON DELETE` are hand-written in the migration SQL and guarded by a drift
// probe in `lib/app/leaf-db-drift.ts` — because Prisma computes desired state from this schema (which
// has no relation for the FK) and a later `migrate dev` would otherwise emit a `DROP` for it. The
// schema-level `onDelete` lint guard does NOT catch a plain-scalar FK, so the probe is the review.
//
// **`ON DELETE` policy per table:** personal data → `CASCADE` (erased with the user); retained
// config/audit → `SET NULL` (de-attributed, the row survives). `app_reclaim_consent` is the one
// `SET NULL` on its own `userId` — a consent record is the evidence that processing was lawful, so it
// must outlive the user (that is why its `userId` is nullable here and nowhere else). `invite` keeps
// its record on `SET NULL` too (it is issued to an email, only *redeemed* by a user).
//
// **No calendar/event table (I4).** Calendar totals live as `reclaim_calendar_*` slot VALUES (F5),
// never as rows here. Nothing in this file stores a meeting.
//
// Scope decision (A, 2026-07-24): all eight tables land now in one migration so the cascades are
// reviewed together (see `.context/app/planning/ryw-shell.md`). F4 gives behaviour only to
// `audit_run` (+ `consent`); the other six carry correct cascades for F6/F7/F8 to fill, and every
// cascade is verified now by the erasure smoke. Columns beyond the core identity are the owning
// feature's to refine — a later `ALTER` is the accepted cost of front-loading.

/// One time-audit run for a user. The run id is also the journey `contextKey` and the slot
/// `provenance.runId` (F4 t-3). Personal data → CASCADE.
model ReclaimAuditRun {
  id     String @id @default(cuid())
  userId String // FK to User.id — no @relation; ON DELETE CASCADE hand-written in the migration

  /// `in_progress | complete | abandoned`. The partial unique index
  /// `(userId) WHERE status = 'in_progress'` (hand-written, drift-probed) enforces one active run.
  status String @default("in_progress")

  /// The audit period label the user set at Phase 0 (e.g. "2026 Q3"). Free text; not an FK.
  quarter String?

  /// The module-surface `AiConversation` this run's coaching happened in (F10 t-1, plan D2).
  ///
  /// Cost is logged per **conversation** (`ai_cost_log.conversationId`) and never per run, and the
  /// surface opens one conversation per `(user, agent, module)` that stays live until the run
  /// completes (I15) — so in practice each run has exactly one, and nothing recorded which. Written
  /// once, lazily, the first time the leaf can observe it; never overwritten. Null means "not
  /// recorded", NOT "cost nothing" — the admin surface must render those distinctly.
  ///
  /// Not an FK: the conversation is core's, it is `SetNull`-erased on its own schedule, and a hard
  /// reference from a leaf table to an orchestration row would couple two unrelated lifecycles.
  conversationId String?

  /// Which coach-opening moments this run has already fired (`coach/opening.ts`).
  ///
  /// Appended once and never removed: a moment is something that happened to a leader, and re-firing
  /// it would replay a beat they have already had — showing them the picture of their week for the
  /// "first" time twice, or re-presenting a gap they have already sat with. The stream route claims a
  /// moment with a conditional `updateMany` **before** generating, so two tabs, a StrictMode double
  /// effect and a reload mid-stream all collapse to one turn.
  ///
  /// A leaf-owned column because there is nowhere else to put it. `UserNodeState.progress` is a
  /// module-defined `Json?` payload and is semantically exactly right, but the framework exposes no
  /// writer for it (`applyJourneyTransition` takes only `{ nodeKey, kind }`), and `JourneyEvent` is
  /// written inside the engine's own transaction. Filed as a Daybreak ask; when a
  /// `recordNodeProgress` seam lands, this ledger moves there and the column goes.
  coachOpenings String[] @default([])

  /// Where each phase's part of the conversation begins: `{ [phaseKey]: messageId }`, the id of the
  /// **last message that already existed** when that phase was entered.
  ///
  /// A run has one conversation across all seven phases (I15 keeps it live until the run completes),
  /// and the transcript was drawn whole on every phase. So a leader on phase 2 met the Phase 2
  /// signpost sitting on top of the entire phase 0 and 1 exchange — a card introducing a
  /// conversation that had already happened. Scrolling to your current question meant scrolling past
  /// an hour of the audit.
  ///
  /// **An id, not a count.** A count is an index into a list the client re-fetches and re-filters
  /// (system rows, tool rows, empty capture turns, our own synthetic triggers all drop out), so the
  /// two coordinate systems would have to agree forever. An id survives any of that: the client
  /// splits on "everything after this message", whatever it decided to render.
  ///
  /// **Written on transition, never on the way back.** Only entering a phase records a mark, so a
  /// leader re-reading phase 1 cannot move phase 2's boundary. A phase with no mark (phase 0, or a
  /// run whose conversation did not exist yet at transition) starts at the beginning, which is
  /// correct in both cases: there is nothing before it.
  ///
  /// Nothing is lost by this — the model's context is untouched, and the earlier turns stay one
  /// disclosure away on screen. It is what the transcript *draws*, not what the audit holds.
  phaseMarks Json @default("{}")

  /// The analyst's two §10 sections for this run: the key gaps, and the phased pathway (F14).
  ///
  /// A per-run artifact, like `coachOpenings` and `phaseMarks` above, and deliberately **not** a
  /// slot. A slot value is what the *leader* said; writing the tool's own prose there would make
  /// every consumer that treats a slot as testimony wrong. One column also means the screen, the
  /// PDF, the email and the public share render identical text rather than three model calls
  /// disagreeing with each other.
  ///
  /// **Nullable with no default, and the distinction is load-bearing.** `null` means "never
  /// generated" and is what the lazy read path keys its write-once `updateMany` on. A `'{}'` default
  /// would make "generated but empty" indistinguishable from "never ran", so a run whose analyst was
  /// refused would never be retried — the same reasoning `conversationId` gives above.
  analystReading Json?

  startedAt   DateTime  @default(now())
  completedAt DateTime?
  /// When the leader let this audit go and started again (F16).
  ///
  /// **Its own column, never `completedAt`.** Three readers treat that field as "this audit
  /// finished" — `listRuns`, the nudge tick's `completedAt ?? startedAt`, and the quarterly
  /// completion timeline — so recording an abandonment there would put abandoned runs into the
  /// nudge cohort and into the trend that measures whether the programme works.
  ///
  /// The row is kept rather than deleted. The phases and the transcript are still the leader's and
  /// still reachable from their history, erasure cascades either way, and "how many started and did
  /// not finish" is a question the operator's measures have to be able to answer.
  abandonedAt DateTime?
  updatedAt   DateTime  @updatedAt

  @@index([userId])
  @@map("app_reclaim_audit_run")
}

/// Terms + privacy acceptance and the marketing-list flag (F8 t-4's legal basis). RETAINED on
/// erasure → `userId` nullable + `SET NULL`: the consent is the proof processing was lawful while the
/// user existed, so erasing it with them would destroy that proof.
model ReclaimConsent {
  id     String  @id @default(cuid())
  userId String? // nullable — SET NULL on erasure (retained config/audit), unique among this schema

  /// The version of terms + privacy policy accepted (e.g. "2026-07-01"). The clauses are Rashmir's
  /// to supply (open item 7); this records which version was accepted.
  policyVersion String

  /// List membership is a separate fact from having an account — only this distinguishes "signed up"
  /// from "consented to Rashmir's list" (F8 t-4, reconciliation 7).
  marketingOptIn Boolean @default(false)

  acceptedAt DateTime @default(now())

  /// One acceptance per user per policy version — a double-submit updates rather than writing a second
  /// row. (Postgres treats NULLs as distinct, so de-attributed rows after erasure never collide.)
  @@unique([userId, policyVersion])
  @@index([userId])
  @@map("app_reclaim_consent")
}

/// Entitlement to run audits (F8 t-2). Free tier = one complete audit; client tier = a 12-month
/// window starting on first use + a `mustStartBy` deadline. Personal entitlement → CASCADE.
model ReclaimGrant {
  id     String @id @default(cuid())
  userId String // ON DELETE CASCADE

  /// `free | client` (F8 t-2). Client status is an admin flag.
  tier String @default("free")

  /// How many complete audits this grant permits, and how many have been consumed. Free = 1.
  auditsGranted Int @default(1)
  auditsUsed    Int @default(0)

  /// Client-tier window: starts on first use, with a deadline to start by (Brief §8). Null for free.
  windowStartsAt DateTime?
  mustStartBy    DateTime?

  /// Which invite minted this grant (provenance; null for the open-signup/standard path). Not an FK
  /// with a cascade — the invite is retained on erasure and this grant is not, so the link is one-way.
  sourceInviteId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([sourceInviteId])
  @@map("app_reclaim_grant")
}

/// A tiered invite (F8 t-1). Issued to an email, redeemed by a user. The record is RETAINED and only
/// *references* a user once redeemed → `redeemedByUserId` nullable + `SET NULL`.
///
/// **Two token stores, deliberately.** Account creation still runs through Sunrise's invitation flow
/// (`lib/utils/invitation-token.ts` → `/accept-invite`), which stores only a SHA-256 hash in
/// `verification`. This table is the leaf's **tier ledger** beside it: `token` holds the SAME hash
/// (never the plaintext), so a row is matchable to an issued invite without weakening the platform's
/// posture. Consume Sunrise's helpers; never edit them (I10).
///
/// **No `@@unique([email])`** — an email can hold more than one invite over time (a referral, then a
/// client invite from Rashmir), and collapsing them would overwrite `invitedByUserId` and silently
/// destroy a referrer's unlock (F8 t-3). Resolution takes the earliest live invite; re-issue rotates
/// the token on the existing row.
model ReclaimInvite {
  id    String @id @default(cuid())
  email String
  token String @unique

  /// `client | standard | referral` (F8 t-1).
  tier String @default("standard")

  /// Who sent it. Null for an admin-issued invite; set for a referral, where it is the ONLY link back
  /// to the referrer whose second audit unlocks on this invitee's first completion (F8 t-3).
  /// FK to User.id — ON DELETE SET NULL (the invite outlives the inviter, like `redeemedByUserId`).
  invitedByUserId String?

  redeemedByUserId String? // FK to User.id — ON DELETE SET NULL (the invite outlives the user)
  redeemedAt       DateTime?

  /// Set when Rashmir withdraws an unredeemed invite. The row is retained (audit), and a revoked
  /// invite resolves to nothing at the entitlement gate.
  revokedAt DateTime?

  /// What happened to the invitation email the last time one was attempted: `sent | failed |
  /// disabled`, or null for a row that predates this column.
  ///
  /// **Recorded because an invite whose email never arrived is invisible otherwise.** The row is the
  /// entitlement and the email is only its delivery, which is the right design — a failed send must
  /// never cost someone their invitation — but it also means a broken mail provider produces a ledger
  /// full of people who are perfectly invited and have no idea. This column is what turns that into
  /// something Rashmir can see and re-send.
  ///
  /// `disabled` (no provider configured) is kept distinct from `failed` (the provider refused)
  /// because they need different things from her: one is a deployment setting, the other is an
  /// incident.
  emailStatus String?

  /// Which group link this invite was claimed through (F11), or null for one she typed by hand.
  ///
  /// Not just reporting: the claim path reads it to recognise a second submission from the same
  /// address through the same link, so a double-tap on a phone costs one seat rather than two.
  ///
  /// A plain column with no FK, for the reason `ReclaimGrant.sourceInviteId` gives — the link is
  /// retained config and the invite is retained audit, so a cascade in either direction would be
  /// wrong, and provenance only ever reads one way.
  viaLinkId String?

  createdAt DateTime @default(now())

  @@index([redeemedByUserId])
  @@index([invitedByUserId])
  @@index([email])
  @@index([viaLinkId])
  @@map("app_reclaim_invite")
}

/// A shareable group invite link (F11) — one URL, printed or shown as a QR code, that a room full of
/// people can claim a standard-tier invitation from.
///
/// **Why this exists at all.** Sunrise's invitation token is bound to ONE email, stored as a hash,
/// and DELETED on acceptance (`/api/auth/accept-invite`) — the first scan would kill it for everyone
/// else. So this is a leaf-owned bearer capability that sits in FRONT of that flow: it proves
/// "Rashmir authorised this person at this tier", and then the ordinary `issueInvite()` path runs
/// unchanged. Nothing downstream (the grant ledger, the anti-escalation check in `grants.ts`, the
/// entitlement gate) learns that group links exist.
///
/// **`token` is PLAINTEXT here, unlike `ReclaimInvite.token`, and that is deliberate.** An invite
/// token is a secret addressed to one person, so only its hash is ever stored. A link token is a
/// bearer capability printed on a slide: Rashmir has to be able to reopen this page next month and
/// reprint the SAME QR code, which a hash makes impossible. `ReclaimShare` stores its public token
/// the same way for the same reason.
///
/// **Bounded by construction.** `maxClaims` and `expiresAt` are both required — a link with neither
/// is an open-signup door with extra steps, and `Module.config.openSignup` already provides that more
/// honestly. Retained config → `createdByUserId` is `SET NULL`.
model ReclaimInviteLink {
  id    String @id @default(cuid())
  token String @unique

  /// What this link is for, in Rashmir's words ("Leadership offsite, March"). Shown on the admin
  /// table and against every invite claimed through it, so a row in the ledger says where it came
  /// from without her having to remember which token was which.
  label String

  /// Always `standard` in v1. Stored rather than assumed so widening it later is a data change:
  /// `client` is the paid twelve-month entitlement and must never be mintable from a forwarded
  /// screenshot, and `referral` is meaningless here (its unlock is owed to a specific referrer).
  tier String @default("standard")

  /// The seat count, and how many have been taken. `claimCount` is only ever moved by a conditional
  /// UPDATE that carries `claimCount < maxClaims` in its WHERE — a read-then-write would let two
  /// simultaneous scans both take the last seat.
  maxClaims  Int
  claimCount Int @default(0)

  /// When the link stops working. Independent of the 7-day expiry on each invitation it issues: a
  /// claim on this link's last day still gets a full fresh 7 days to accept.
  expiresAt DateTime

  /// Set when Rashmir withdraws the link. Retained (audit), and it does NOT revoke the invitations
  /// already claimed through it — those people accepted in good faith.
  revokedAt DateTime?

  /// Who minted it. FK to User.id — ON DELETE SET NULL (retained config; the link outlives them).
  createdByUserId String?

  createdAt DateTime @default(now())

  @@index([createdByUserId])
  @@map("app_reclaim_invite_link")
}

/// A user's display label for a canonical bucket (F6 t-4). The canonical `bucketSlug` is NEVER
/// changed (I7) — only the display label is stored here — so relabelled audits still aggregate by the
/// slug. Per-user (carried across runs, F9 t-4). Personal → CASCADE.
model ReclaimBucketLabel {
  id     String @id @default(cuid())
  userId String // ON DELETE CASCADE

  /// One of the nine canonical `bucketSlug` values (content-source §1). Storage key, never renamed.
  bucketSlug String

  /// The user's chosen label. "Within limits" (Brief §3) = a length cap enforced at the write.
  label String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, bucketSlug])
  @@index([userId])
  @@map("app_reclaim_bucket_label")
}

/// A tokenised link to a user's own summary artifact (F7 t-4). Sharing is invited, never required.
/// Personal → CASCADE (erasing the user revokes their share links).
///
/// `@@unique([userId, auditRunId])` (F10 t-1, plan D8) is what makes "one share link per run" true in
/// the database rather than in a `findFirst` that races itself. F7's gate round fixed an observed
/// duplicate with a read-then-create, which [[planning-retro]] §B says is always a TOCTOU; F10 t-3
/// counts these rows, so a duplicate stops being cosmetic.
model ReclaimShare {
  id         String @id @default(cuid())
  userId     String // ON DELETE CASCADE
  auditRunId String
  token      String @unique

  createdAt DateTime @default(now())

  @@unique([userId, auditRunId])
  @@index([userId])
  @@map("app_reclaim_share")
}

/// A result shared *with the coach* — the shared-results inbox (F7 t-4's existing-client close, read
/// by F10 t-3). Distinct from `ReclaimShare` (the user's own public link). Personal → CASCADE.
model ReclaimReportShare {
  id         String @id @default(cuid())
  userId     String // ON DELETE CASCADE
  auditRunId String

  /// Whether the leader also let Rashmir read the conversation, not only the results (F17).
  ///
  /// **Its own fact, like `quoteConsent` next door.** Sharing a summary is not sharing the exchange
  /// that produced it: a transcript carries what someone said while working something out, in the
  /// order they worked it out, including the parts they went back on. A leader can want the first
  /// and not the second, and until this column there was no way to say so — while the conversation
  /// was reachable anyway, through a `conversationId` the admin export handed over.
  ///
  /// `NOT NULL DEFAULT false` rather than nullable, so absent consent reads as "not given" and no
  /// reader can reach for a `?? true`. Withdrawable: unticking this, or the share itself, sets it
  /// back to false, because consent that cannot be taken back is not consent.
  transcriptConsent Boolean @default(false)

  createdAt DateTime @default(now())

  /// One coach-share per run (F10 t-1, plan D8) — see `ReclaimShare`. The inbox counts these.
  @@unique([userId, auditRunId])
  @@index([userId])
  @@map("app_reclaim_report_share")
}

/// One-line feedback + demographics captured only after a user chooses to share (F7 t-4). The
/// quote-consent flag governs republication and is its own fact, separate from sharing.
///
/// **Personal → CASCADE, and that is now a decision rather than a default (F10 t-3).** F4 t-1 left
/// open "whether an anonymised, quote-consented line is split to a retained store"; F7 shipped
/// without splitting it, and F10 read this table for the inbox, which is the point at which somebody
/// had to actually choose. The choice is to keep CASCADE: a quote consent is given *by a person*, and
/// a person who has since exercised their right to erasure has withdrawn the standing their consent
/// rested on. Retaining the sentence de-attributed would leave the product able to publish the words
/// of someone who asked to be forgotten — which is the specific outcome erasure exists to prevent,
/// and no amount of "it is anonymised" changes whose sentence it is.
///
/// The operational answer for Rashmir is out of band and better anyway: if she wants to use a quote,
/// she asks that leader at the time. Losing a testimonial is a cheaper failure than keeping one.
model ReclaimFeedback {
  id         String  @id @default(cuid())
  userId     String // ON DELETE CASCADE
  auditRunId String?

  /// "In a sentence: what did you take from this?"
  text String

  /// "Happy for this to be quoted anonymously" — a separate consent from sharing (Brief §3).
  quoteConsent Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("app_reclaim_feedback")
}

/// The quarterly nudge (F9 t-3, Brief §2: "gentle and quarterly rather than frequent").
///
/// One row per leader, holding the three facts a nudge needs and nothing else: whether they have
/// opted out, which audit cycle they were last nudged for, and the token that lets them opt out
/// **without logging in**.
///
/// **Why the opt-out lives here and not on `ReclaimConsent`.** `marketingOptIn` means "on Rashmir's
/// list" — F8 t-4 was explicit that list membership is a separate fact from having an account — and
/// `ReclaimConsent` is the retained lawful-basis record with a deliberate `SET NULL`. Conflating the
/// two would let unsubscribing from a product nudge silently change a marketing consent, or survive
/// erasure. This is programme state: personal data → CASCADE.
///
/// **`lastNudgedForRunId` is what makes "at most one per cycle" true.** It records the completed
/// audit the last nudge was sent about, so re-running the tick cannot send a second — the check is a
/// comparison, not a count, which is the deterministic-key lesson F6 and F8 both paid for.
model ReclaimNudge {
  id     String @id @default(cuid())
  userId String @unique // ON DELETE CASCADE — one row per leader

  /// Set when the leader turns nudges off. Null = still willing to hear from us.
  optedOutAt DateTime?

  /// The completed audit the most recent nudge was sent about — the per-cycle idempotence key.
  lastNudgedForRunId String?
  lastNudgedAt       DateTime?

  /// The unsubscribe token. Unguessable, and the ONLY thing the opt-out route needs — a leader who
  /// has stopped using the product must not have to log in to make the email stop.
  token String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("app_reclaim_nudge")
}

/// One message Rashmir wrote to a leader herself (F18 t-2).
///
/// **Not a nudge, and the distinction is the whole reason this table exists.** `ReclaimNudge` is the
/// scheduler's state: one row per leader, a cadence, an opt-out. This is a log of messages a human
/// composed after looking at a record and deciding — which post-v1 P24 names as the version I16 is
/// comfortable with, against an automated "you left an audit open" that Brief §2 and
/// `nudges/select.ts` both refuse.
///
/// **A row per message rather than columns on the nudge row**, unlike F17's consent flag: a coach
/// writes to a leader across several audits and the question the screen has to answer is "what did I
/// already say, and when", which a single latest-message triple cannot hold.
///
/// `auditRunId` is nullable and carries no FK, matching `ReclaimNudge.lastNudgedForRunId`: it is
/// one-way provenance about which audit prompted the message, and a leader who has never started one
/// can still be written to.
///
/// Personal data → CASCADE on `userId` (their address, and words about them). The **sender** is
/// SET NULL: an admin account is erasable too, and erasing Rashmir must de-attribute her outbox
/// rather than delete the record that a leader was contacted.
model ReclaimReachOut {
  id     String @id @default(cuid())
  userId String // FK to User.id — ON DELETE CASCADE (personal data)

  /// Which audit prompted it, where one did. No FK — provenance, like `lastNudgedForRunId`.
  auditRunId String?

  /// The operator who wrote it. FK to User.id — ON DELETE SET NULL (the record outlives the sender).
  sentByUserId String?

  /// What the leader received. Kept so the next message can be written knowing the last one.
  subject String
  body    String

  /// `sent` or `failed`. A failed send is recorded deliberately: an operator who is told nothing
  /// would write again, and a provider outage should read as one rather than as silence.
  status String @default("sent")

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([auditRunId])
  @@map("app_reclaim_reach_out")
}

/// A test participant, created by an operator to walk the product (F19).
///
/// **The row IS the fact "this account is not a client."** Nothing else distinguishes one, and that is
/// deliberate: a preview account signs in, consents, and runs the audit through the same routes a
/// leader does, which is the whole point of having them. `User.accountType` cannot carry the fact —
/// `SERVICE` is a non-login principal, and `prisma/schema/auth.prisma` is Sunrise's under I10 — so it
/// lives here, and the exclusion downstream is an id-set read rather than a `where` fragment.
///
/// **What the fact is for.** Preview accounts must not move the published figures. A fabricated audit
/// entering `readAggregate`'s cohort can push it past `aggregateMinimumCohort` and get invented hours
/// published as the k-anonymised number; a fabricated completed run enters the quarterly nudge cohort
/// and a real email is dispatched. Both are read-time exclusions keyed on this table, guarded by
/// `tests/unit/invariants/preview-exclusion.test.ts`.
///
/// The operator screens (`listClients`, `listSharedResults`) deliberately still **show** these
/// accounts, badged. Hiding them would mean an operator could not find the test accounts she made in
/// order to remove them.
///
/// Personal data → CASCADE on `userId`: erasing the account must take the registry row with it, or the
/// exclusion list names a user id that no longer exists. The operator → SET NULL, matching
/// `app_reclaim_invite_link.createdByUserId`, because an admin account is erasable too and erasing her
/// must not delete a live test account she happened to create.
model ReclaimPreviewAccount {
  id     String @id @default(cuid())
  userId String @unique // FK to User.id — ON DELETE CASCADE (personal data)

  /// What this account is for, in the operator's words ("Rashmir's walkthrough, Aug 12"). Shown on the
  /// badge wherever the account appears, so a row nobody remembers creating still explains itself.
  label String

  /// Who created it. FK to User.id — ON DELETE SET NULL (the account outlives its creator).
  createdByUserId String?

  createdAt DateTime @default(now())

  @@index([createdByUserId])
  @@map("app_reclaim_preview_account")
}
